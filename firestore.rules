rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Username -> uid lookup. Get-only, and only by an exact name someone
    // already typed in — there is no "list all usernames", so this can't
    // be used to enumerate who's on the platform.
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(name));
      allow update, delete: if false; // usernames are permanent for now
    }

    match /users/{userId} {

      // Public profile: username, displayName, photoURL. Email is never
      // written here, so "viewable minus the email address" is true by
      // construction — there's nothing to filter out at read time.
      match /publicProfile/info {
        allow get: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // The real progress/stats/badges data. Owner always has full
      // access. An accepted friend gets read-only access, proven by
      // existing in the owner's own friends list. Everyone else: denied.
      match /progress/{courseId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId
              || exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)));
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Incoming friend requests, keyed by the sender's uid. Only the
      // sender can create their own request (and can't send one to
      // themselves). Sender or receiver can read/cancel a single request.
      // Only the receiver can list the full incoming set.
      match /friendRequests/{senderUid} {
        allow get: if request.auth != null && (request.auth.uid == userId || request.auth.uid == senderUid);
        allow list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == senderUid && senderUid != userId;
        allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == senderUid);
      }

      // Mutual friendship edges, stored on both people's users/{uid}
      // documents. Creating an edge requires a real friend request to
      // exist between the two people in EITHER direction — so nobody can
      // inject themselves into someone's friends list unrequested.
      match /friends/{friendId} {
        allow get: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendId);
        allow list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendId)
          && (exists(/databases/$(database)/documents/users/$(userId)/friendRequests/$(friendId))
              || exists(/databases/$(database)/documents/users/$(friendId)/friendRequests/$(userId)));
        allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }
  }
}
